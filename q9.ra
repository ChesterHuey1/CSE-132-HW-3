johnLoans := \select_{lno = no and cname = 'John Smith'}(borrower \cross loan);
johnLoanInfo := \project_{no, minCredit}(johnLoans);
johnLoanInfo2 := \rename_{jl2: no2, minCredit2}(johnLoanInfo);
notMax := \project_{no}(
  \select_{minCredit < minCredit2}(
    johnLoanInfo \cross johnLoanInfo2
  )
);
\rename_{result: loanNo}(
  \project_{no}(johnLoanInfo) \diff notMax
)
